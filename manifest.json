{
    "manifest_version": 3,
    "name": "Boring Social Media",
    "version": "1.0",
    "description": "Turns social media grayscale and shows facts to reduce dopamine triggers.",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.tiktok.com/*",
        "*://*.threads.net/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/shorts/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.instagram.com/*",
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.facebook.com/*",
                "*://*.tiktok.com/*",
                "*://*.threads.net/*",
                "*://*.reddit.com/*",
                "*://*.youtube.com/shorts/*"
            ],
            "css": [
                "style.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}